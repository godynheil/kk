# ==============================================================================
# kk - Environment Variables Configuration Template
# This file serves as a template (.env.example) for configuring environmental
# variables for build-time credentials, integration testing, and runtime overrides.
#
# Copy this file to '.env' and populate it with your actual credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Build & Core Credentials
# ------------------------------------------------------------------------------
# These credentials are used at build time (e.g. via make.ps1 or Makefile)
# to bake default OAuth credentials into the executable. They are also checked
# at runtime as fallback environment variables.

# Google OAuth 2.0 Desktop Application Client ID for Google Drive integration.
# Format: <digits>-<alphanumeric>.apps.googleusercontent.com
KK_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google OAuth 2.0 Desktop Application Client Secret.
KK_GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here

# Optional Windows Authenticode signing settings for make.ps1 and
# scripts/portable-windows.ps1. Signing is skipped unless either
# KK_SIGN_CERT_PATH or KK_SIGN_CERT_SHA1 is set.

# Full path to signtool.exe if it is not already on PATH.
#KK_SIGNTOOL_PATH=C:\Program Files (x86)\Windows Kits\10\bin\x64\signtool.exe

# Option A: sign with a PFX certificate file.
#KK_SIGN_CERT_PATH=C:\certs\kk-code-signing.pfx
#KK_SIGN_CERT_PASSWORD=your_pfx_password

# Option B: sign with a certificate already installed in the certificate store.
#KK_SIGN_CERT_SHA1=your_certificate_thumbprint
#KK_SIGN_MACHINE_STORE=false

# Defaults are SHA256 and DigiCert timestamping if omitted.
#KK_SIGN_DIGEST_ALG=SHA256
#KK_SIGN_TIMESTAMP_URL=http://timestamp.digicert.com


# ------------------------------------------------------------------------------
# 2. Testing & CI Integration
# ------------------------------------------------------------------------------
# Used by PowerShell E2E test scripts to programmatically create and reset
# temporary repositories or manage assets in automation.

# GitHub Personal Access Token (PAT) with repository access.
# Format: ghp_<alphanumeric>
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# GitLab Personal Access Token (PAT) with repository access.
# Format: glpat-<alphanumeric>
GITLAB_TOKEN=glpat-your_gitlab_personal_access_token_here


# ------------------------------------------------------------------------------
# 3. Advanced Customization & Overrides (Optional)
# ------------------------------------------------------------------------------
# These variables do not need to be set unless you are troubleshooting, testing,
# or customizing performance limits. Un-comment them to override defaults.

# The number of concurrent worker routines for processing jobs.
# Default: 4
#KK_WORKERS=4

# Custom OAuth 2.0 token endpoint to retrieve Google Drive tokens.
# Default: https://oauth2.googleapis.com/token
#KK_GDRIVE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token

# Overrides the default directory where Google Drive credentials (JSON) are stored.
# Default: %APPDATA%\KK\gdrive (Windows) or ~/.config/KK/gdrive (Linux/macOS)
#KK_GDRIVE_AUTH_DIR=C:\Users\Username\custom_auth_dir

# Base API endpoint for Google Drive operations.
# Default: https://www.googleapis.com/drive/v3/
#KK_GDRIVE_API_BASE=https://www.googleapis.com/drive/v3/

# Base upload API endpoint for Google Drive operations.
# Default: https://www.googleapis.com/upload/drive/v3/
#KK_GDRIVE_UPLOAD_BASE=https://www.googleapis.com/upload/drive/v3/

# Timeout duration (in seconds) for Google Drive upload requests.
# Default: 300
#KK_GDRIVE_UPLOAD_TIMEOUT=300

# Chunk size (in Megabytes) for Google Drive resumable uploads. Must be a multiple of 256KB.
# Default: 8
#KK_GDRIVE_CHUNK_SIZE=8

# The number of parallel file transfers for rclone operations.
# Default: 4
#KK_RCLONE_TRANSFERS=4

# Memory buffer size (in Megabytes) for rclone copy/sync operations.
# Default: 16
#KK_RCLONE_BUFFER_SIZE=16
